DB_URL=jdbc:postgresql://aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=replace-with-your-supabase-database-password
JWT_SECRET=replace-with-a-long-random-production-secret
JWT_EXPIRATION_MS=86400000

APP_PORT=8088
APP_CORS_ALLOWED_ORIGINS=http://localhost:8088

# Enable only for the first startup of a database without an administrator.
# Disable it and clear the values after the account has been created.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_FULL_NAME=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

SIMULATION_SCHEDULER_ENABLED=true
SIMULATION_SCHEDULER_DELAY_MS=5000
SIMULATION_DEFAULT_INTERVAL_SECONDS=15
SIMULATION_DEFAULT_MAX_EVENTS=500

STOCK_MONITORING_SCHEDULER_ENABLED=true
STOCK_MONITORING_SCHEDULER_DELAY_MS=30000

BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=http://host.docker.internal:8545
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_GAS_PRICE_WEI=20000000000
BLOCKCHAIN_GAS_LIMIT=250000

VITE_DASHBOARD_REFRESH_MS=15000
VITE_ALERT_BADGE_REFRESH_MS=15000
